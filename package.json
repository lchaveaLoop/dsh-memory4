{
  "name": "dsh-memory4",
  "version": "0.3.3",
  "private": true,
  "description": "Four-in-one memory for DeepSeek Harness: working, episodic, semantic and procedural memory with explicit write/recall policies and compaction handoff.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test"
  },
  "license": "MIT"
}
